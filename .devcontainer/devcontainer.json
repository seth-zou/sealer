{
    "name": "sealer",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    // sealer uses vendored Go modules and GOPATH-style checkout in CI
    // (src/github.com/alibaba/sealer). Set GOPATH and clone the repo into it so
    // deepcopy-gen (run via `make deepcopy`) resolves the output-base correctly.
    "remoteEnv": {
        "GO111MODULE": "on",
        "GOPATH": "/go"
    },
    "settings": {
        "go.goToolsManagerAutoUpdate": false,
        "go.gopath": "/go",
        "go.useLanguageServer": true,
        "go.formatTool": "goimports",
        "go.lintTool": "golangci-lint",
        "go.lintOnSave": "workspace",
        "go.testOnSave": false,
        "go.buildOnSave": "workspace",
        "go.toolsEnvVars": {
            "GO111MODULE": "on"
        },
        "gopls": {
            "build.experimentalWorkspaceModule": false
        }
    },
    "extensions": [
        "golang.Go",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "eamodio.gitlens",
        "GitHub.vscode-pull-request-github"
    ],
    "postCreateCommand": "go mod download && git config --global --add safe.directory /workspaces/sealer",
    "remoteUser": "vscode",
    "portsAttributes": {
        "8080": {
            "label": "sealer debug",
            "onAutoForward": "notify"
        }
    }
}
